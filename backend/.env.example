# SwipeX Environment Configuration Template
# Copy this file to .env and configure your environment variables

# Django Security
SECRET_KEY=django-insecure-swipex-dev-key-replace-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL Database Configuration
DB_NAME=SwipeX_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Groq Cloud API Key for AI Resume Feedback (Optional / Fallback provided)
GROQ_API_KEY=your_groq_api_key_here
