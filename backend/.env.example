# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True

# Database (PostgreSQL)
DB_NAME=swipex
DB_USER=postgres
DB_PASSWORD=yourpass
DB_HOST=localhost
DB_PORT=5432

# Set to True to use SQLite instead of Postgres for quick local testing
USE_SQLITE=False

# OAuth2 (Google) - get these from https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth2 (GitHub) - get these from https://github.com/settings/developers
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
